# On your PC, localhost is correct. On a PHONE/TABLET testing over WiFi,
# "localhost" means the phone itself (no backend there) — use your PC's
# LAN IP instead, e.g. http://192.168.0.101:4000 (same IP shown in
# "Network: http://..." when you run npm run dev). Must also be added to
# FRONTEND_ORIGIN in backend/.env, comma-separated.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional — footer social icons only render for the ones you set
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/254702543867
