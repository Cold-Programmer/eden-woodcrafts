PORT=4000
# For testing on your phone/tablet over WiFi, add your PC's LAN IP too,
# comma-separated (find it with `ip addr` / `ipconfig` — same one shown
# in "Network: http://..." when you run npm run dev):
FRONTEND_ORIGIN=http://localhost:3000,http://192.168.0.101:3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eden_woodcrafts"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-too-a-different-long-random-string"

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Safaricom's publicly-documented sandbox test passkey — works for most
# sandbox apps as-is. If Daraja rejects it, get your app-specific one from
# developer.safaricom.co.ke → My Apps → your app → Lipa Na M-Pesa Online.
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://your-domain-or-ngrok/api/payments/mpesa/callback

# Only needed if you use `npm run dev:tunnel` — get your own free token
# from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
NGROK_STATIC_DOMAIN=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
